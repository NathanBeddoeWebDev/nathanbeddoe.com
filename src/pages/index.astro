---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout>
    <section class="page-section">
        <div class="panel">
            <div class="panel__image">
                <img src="/images/me.webp" alt="Nathan sitting on the bridge looking out to the Ponte Vecchio in Florence.">
            </div>
            <div class="panel__content">
                <h1 class="title">Nathan Beddoe</h1>
                <p class="lead">
                    An Australian software developer with expertise in frontend web
                    and API development.
                </p>
                <ul class="links-list">
                    <li><a href="/about">About Me</a></li>
                    <li><a href="#">Resume</a></li>
                    <li><a href="#">Projects</a></li>
                </ul>
            </div>

        </div>
    </section>
</SiteLayout>

<style>
    .page-section {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;
    }
    .panel {
        display: flex;
        width: 768px;
        max-width: 100%;
        gap: 1.5rem;
    }

    @media screen and (max-width: 540px) {
        .panel {
            flex-direction: column;
            padding-inline: 1rem;
        }

        .page-section {
            align-items: start;
            padding-block: 1.5rem;
        }
    }

    .panel__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .title {
        text-align: left;
        width: 100%;
    }
    .links-list {
        width: 100%;
        text-align: left;
        display: flex;
        list-style: none;
        padding-left: 0;
        gap: 2rem;
        justify-content: start;
    }
</style>
